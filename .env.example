# Keep real secrets only in an untracked .env / Vercel dashboard.
# Full working template: Desktop/PAIDIA_COMPLETE.env (after generation).

# ── REQUIRED — AI ─
GROQ_API_KEY=
GROQ_OCR_MODEL=qwen/qwen3.6-27b
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# ── REQUIRED — App / URLs ─
PAIDIA_HOST=127.0.0.1
PAIDIA_PORT=5173
PAIDIA_PUBLIC_URL=http://127.0.0.1:5173
PAIDIA_COOKIE_SECURE=false
# Required on Vercel — without this, sessions refuse to mint.
PAIDIA_SESSION_SECRET=
PAIDIA_ADMIN_PROFILE_IDS=e3,e4,e8
# On Vercel, PIN/email overrides survive via PAIDIA_AUTH_OVERRIDES_JSON + device cookie.
# PAIDIA_AUTH_OVERRIDES_JSON=
# PAIDIA_AUTH_OVERRIDES_PATH=.paidia-auth-overrides.json
# On Vercel production set a real https origin (never localhost) so PIN-reset emails are safe:
# PAIDIA_PUBLIC_URL=https://armonia-thassos.vercel.app
# Also set RESEND_API_KEY + RESEND_FROM (or SMTP_*) or the reset button stays disabled.

# ── REQUIRED — Auth (salted PIN hashes only — never plaintext PINs here) ─
# Seed for first boot. After that, DB is the source of truth (survives UI deploys).
PAIDIA_AUTH_USERS_JSON={}

# ── REQUIRED on Vercel — durable database (Neon / Vercel Postgres / any Postgres) ─
# Without this, auth/ops/talk/passkeys reset on cold starts / deploys.
# Locally omitted → SQLite file .paidia.db is used automatically.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Or Vercel/Neon auto vars:
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# Optional local override:
# PAIDIA_SQLITE_PATH=.paidia.db

# ── REQUIRED — Passkeys ─
PAIDIA_WEBAUTHN_ORIGIN=http://127.0.0.1:5173
PAIDIA_WEBAUTHN_RP_ID=localhost
PAIDIA_WEBAUTHN_RP_NAME=Armonia Thassos
PAIDIA_PASSKEY_STORE_PATH=.paidia-passkeys.json
# Optional one-time seed into DB (migrate script / first boot):
# PAIDIA_PASSKEYS_JSON=
# PAIDIA_OPS_JSON=
PAIDIA_ONBOARDING_STATE_PATH=.paidia-onboarding.json

# ── REQUIRED — Security ─
PAIDIA_TRUST_PROXY=false
PAIDIA_TRUSTED_PROXY_NETWORKS=
PAIDIA_TRUSTED_NETWORKS=
PAIDIA_LOGIN_MAX_ATTEMPTS=5
PAIDIA_LOGIN_WINDOW_SECONDS=600
PAIDIA_LOGIN_LOCK_SECONDS=900
PAIDIA_IP_MAX_FAILURES=20
PAIDIA_PROFILE_MAX_FAILURES=12
PAIDIA_SECURITY_ALERT_AFTER=3
PAIDIA_SECURITY_ALERT_COOLDOWN=3600
PAIDIA_SECURITY_ALERT_EMAIL=
PAIDIA_SECURITY_STATE_PATH=.paidia-security-state.json
PAIDIA_SECURITY_LOG_PATH=.paidia-security-events.jsonl

# ── REQUIRED — Email ─
# Local: SMTP (Gmail App Password) works well.
# Vercel: prefer Resend — outbound SMTP ports are often blocked.
# If both are set, local prefers SMTP and Vercel prefers Resend (with automatic fallback).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Resend — use a verified domain sender in production (not only @resend.dev).
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
RESEND_API_URL=https://api.resend.com/emails

# Public URL for PIN-reset links (must be the live site on Vercel).
# PAIDIA_PUBLIC_URL=https://armonia-thassos.vercel.app

# ── OPTIONAL — WhatsApp Cloud API ─
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_SEND_ENABLED=false
WHATSAPP_EVENT_TEMPLATE=paidia_event_notification
WHATSAPP_TEMPLATE_LANGUAGE=de
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_TEST_TEMPLATE=hello_world
WHATSAPP_TEST_LANGUAGE=en_US
WHATSAPP_RECIPIENTS_JSON={}
