# Keep real keys only in an untracked .env or your shell environment.
GROQ_API_KEY=
GROQ_OCR_MODEL=qwen/qwen3.6-27b
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
PAIDIA_HOST=127.0.0.1
PAIDIA_PORT=5173

# WhatsApp Cloud API — keep real values only in the untracked .env.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_SEND_ENABLED=false
WHATSAPP_EVENT_TEMPLATE=paidia_event_notification
WHATSAPP_TEMPLATE_LANGUAGE=de
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_TEST_TEMPLATE=hello_world
WHATSAPP_TEST_LANGUAGE=en_US
# JSON mapping of child IDs to approved guardian/test E.164 numbers, e.g. {"k1":"491234567890"}
WHATSAPP_RECIPIENTS_JSON={}

# Server-side authentication. Populate with salted hashes; never put PINs in index.html.
PAIDIA_AUTH_USERS_JSON={}
PAIDIA_PUBLIC_URL=http://localhost:5173
PAIDIA_COOKIE_SECURE=false

# Synology MailPlus SMTP or another SMTP provider for one-time PIN reset links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
