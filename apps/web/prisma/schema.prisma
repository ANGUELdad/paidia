// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id        String   @id
  name      String
  mode      String // staff|child
  role      String?
  admin     Boolean  @default(false)
  color     String?
  email     String?
  phone     String?
  pinHash   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  prefs     Prefs?
  passkeys  Passkey[]
  sessions  Session[]
}

model Prefs {
  id           String  @id @default(cuid())
  profileId    String  @unique
  profile      Profile @relation(fields: [profileId], references: [id])
  nickname     String?
  emoji        String?
  color        String?
  lang         String  @default("de")
  widgetsJson  String  @default("[]")
}

model Passkey {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id])
  credentialId String   @unique
  publicKey    String
  label        String?
  createdAt    DateTime @default(now())
}

model Session {
  id        String   @id
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])
  mode      String
  admin     Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model House {
  id    String @id
  name  String
  short String
}

model Product {
  id       String @id
  nameDe   String
  nameEl   String
  unit     String
  category String
}

model StockLedger {
  id        String   @id @default(cuid())
  houseId   String
  productId String
  qty       Float
  dir       String
  reason    String?
  by        String?
  createdAt DateTime @default(now())
}

model ListItem {
  id        String   @id @default(cuid())
  houseId   String
  productId String?
  name      String
  qty       Float
  unit      String
  status    String   @default("open")
  by        String?
  createdAt DateTime @default(now())
}

model ScheduleEntry {
  id          String   @id @default(cuid())
  date        String
  block       String
  activity    String
  houseIds    String   @default("[]")
  employeeIds String   @default("[]")
  childIds    String   @default("[]")
  fromTime    String
  toTime      String
  note        String?
  cancelled   Boolean  @default(false)
  by          String?
  createdAt   DateTime @default(now())
}

model ShiftNote {
  id        String   @id @default(cuid())
  profileId String
  date      String
  text      String
  updatedAt DateTime @updatedAt
  @@unique([profileId, date])
}

model ShiftCheckin {
  id        String   @id @default(cuid())
  profileId String
  date      String
  shiftId   String
  status    String
  reason    String?
  createdAt DateTime @default(now())
}

model TalkMessage {
  id        String   @id @default(cuid())
  profileId String
  text      String
  createdAt DateTime @default(now())
}

model MeetingNote {
  id      String   @id @default(cuid())
  weekKey String   @unique
  text    String
  by      String?
  updatedAt DateTime @updatedAt
}

model NotificationRule {
  id       String  @id
  kind     String  @unique
  enabled  Boolean @default(true)
  channels String  @default("[\"local\",\"push\"]")
}

model PushSubscription {
  id        String   @id @default(cuid())
  profileId String
  endpoint  String   @unique
  keysJson  String
  mode      String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  type      String
  profileId String?
  text      String
  createdAt DateTime @default(now())
}

model LearningSignal {
  id        String   @id @default(cuid())
  kind      String
  profileId String?
  payload   String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Entry — append-only unified records spine
// Replaces the five separate note shapes (shiftNotes, incidents, careLogs,
// handoverNotes, meetingNotes) with one auditable model.
//
// Migration SQL (run manually — do NOT apply to production automatically):
//
// CREATE TABLE IF NOT EXISTS "Entry" (
//   "id"                TEXT      NOT NULL PRIMARY KEY,
//   "kind"              TEXT      NOT NULL,
//   "authorProfileId"   TEXT      NOT NULL,
//   "houseId"           TEXT,
//   "childProfileId"    TEXT,
//   "tags"              TEXT      NOT NULL DEFAULT '[]',
//   "body"              TEXT      NOT NULL,
//   "attachments"       TEXT,
//   "serverCreatedAt"   DATETIME  NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
//   "clientRef"         TEXT,
//   "archivedAt"        DATETIME
// );
// CREATE INDEX IF NOT EXISTS "Entry_kind_idx"              ON "Entry"("kind");
// CREATE INDEX IF NOT EXISTS "Entry_authorProfileId_idx"   ON "Entry"("authorProfileId");
// CREATE INDEX IF NOT EXISTS "Entry_childProfileId_idx"    ON "Entry"("childProfileId");
// CREATE INDEX IF NOT EXISTS "Entry_houseId_idx"           ON "Entry"("houseId");
// CREATE UNIQUE INDEX IF NOT EXISTS "Entry_clientRef_key"  ON "Entry"("clientRef");
// ---------------------------------------------------------------------------
model Entry {
  id              String    @id @default(uuid())
  // journal | incident | care | handover | meeting | note
  kind            String
  authorProfileId String
  houseId         String?
  childProfileId  String?
  // JSON-encoded string[]; Prisma stores as TEXT in SQLite
  tags            String    @default("[]")
  body            String
  // JSONB in Postgres; TEXT in SQLite — store as JSON string
  attachments     String?
  // Stamped by the server on write — never accept from client
  serverCreatedAt DateTime  @default(now())
  // Optional idempotency key supplied by client for dedup
  clientRef       String?   @unique
  // Soft-archive: null = active; non-null = archived
  archivedAt      DateTime?
}

model BuildInfo {
  id      Int    @id @default(1)
  version Int
  label   String
  changedDe String
  changedEl String
}
