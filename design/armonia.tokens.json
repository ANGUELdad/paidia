  "motion": {
    "fast": {
      "$value": "120ms"
    },
    "base": {
      "$value": "220ms"
    },
    "slow": {
      "$value": "380ms"
    },
    "reveal": {
      "$value": "480ms"
    },
    "stagger-sm": {
      "$value": "60ms"
    },
    "stagger-md": {
      "$value": "80ms"
    },
    "ease-settle": {
      "$value": "cubic-bezier(0.2,0.8,0.2,1)"
    },
    "ease-tide": {
      "$value": "cubic-bezier(0.65,0,0.35,1)"
    }
  },
  "elevation": {
    "glass-1": {
      "$value": "background glass/64, 1px line/12, blur 10px, radius md, shadow 0 6px 18px rgba(26,40,34,.08)"
    },
    "glass-2": {
      "$value": "background glass/86, 1px line/12 + 1px glass/rim top, blur 16px, radius lg, shadow 0 18px 40px rgba(26,40,34,.14)"
    },
    "chrome": {
      "$value": "background chrome/900, blur 12px, radius dock"
    }
  }
