# Keep real secrets only in an untracked .env / Vercel dashboard.
# Full working template: Desktop/PAIDIA_COMPLETE.env (after generation).

# ── REQUIRED — AI ─
GROQ_API_KEY=
GROQ_OCR_MODEL=qwen/qwen3.6-27b
GROQ_CHAT_MODEL=openai/gpt-oss-120b
# Retired Groq IDs (llama-3.3-70b-versatile, llama-3.1-8b-instant) are remapped at runtime.

# ── OCR — xAI Grok (preferred for image / screenshot OCR) ─
# XAI_API_KEY=
# GROK_API_KEY=
# XAI_OCR_MODEL=grok-2-vision-1212
# PAIDIA_OCR_PROVIDER=auto
# Docs: docs/agents/OCR_GROK.md

# ── Zo-Ai LLM routing (OmniRoute local gateway) ─
# auto = prefer OmniRoute when reachable, else Groq (recommended locally)
PAIDIA_LLM_PROVIDER=auto
OMNIROUTE_BASE_URL=http://127.0.0.1:20128
OMNIROUTE_CHAT_MODEL=auto/best-reasoning
# OMNIROUTE_API_KEY=
# PAIDIA_ZOAI_KNOWLEDGE_CHARS=5500
# PAIDIA_CHAT_ACTION_MAX=12

# ── REQUIRED — App / URLs ─
PAIDIA_HOST=127.0.0.1
PAIDIA_PORT=5173
PAIDIA_PUBLIC_URL=http://127.0.0.1:5173
PAIDIA_COOKIE_SECURE=false
# Required on Vercel — without this, sessions refuse to mint.
PAIDIA_SESSION_SECRET=
PAIDIA_ADMIN_PROFILE_IDS=e3,e4,e8
# On Vercel, PIN/email overrides survive via PAIDIA_AUTH_OVERRIDES_JSON + device cookie.
# PAIDIA_AUTH_OVERRIDES_JSON=
# PAIDIA_AUTH_OVERRIDES_PATH=.paidia-auth-overrides.json
# On Vercel production set a real https origin (never localhost) so PIN-reset emails are safe:
# PAIDIA_PUBLIC_URL=https://armonia-thassos.vercel.app
# Also set RESEND_API_KEY + RESEND_FROM (or SMTP_*) or the reset button stays disabled.

# ── REQUIRED — Auth (salted PIN hashes only — never plaintext PINs here) ─
# Seed for first boot. After that, DB is the source of truth (survives UI deploys).
PAIDIA_AUTH_USERS_JSON={}

# ── REQUIRED on Vercel — IPv4 POOLED Postgres (not direct db.*:5432) ─
# Vercel has no IPv6 egress. Direct Supabase db.<ref>.supabase.co:5432 fails with
# "Cannot assign requested address".
#
# Supabase → Project Settings → Database → Connection string → Transaction pooler:
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
#
# Neon → connection string with `-pooler` in the host (not the direct ep-*.neon.tech:5432 URL).
# POSTGRES_URL / POSTGRES_PRISMA_URL are aliases for DATABASE_URL.
#
# Locally omitted → SQLite file .paidia.db is used automatically.
# Optional local override:
# PAIDIA_SQLITE_PATH=.paidia.db
#
# After setting DATABASE_URL on Vercel:
#   1) Redeploy
#   2) Open Profil — green "Server-Speicher" banner must appear
#   3) Save once (any stock/list change) so this device seeds the database
#   4) Optional: python scripts/migrate_to_db.py locally then push ops if needed

# ── REQUIRED — Passkeys ─
# Production (Vercel): never use localhost — Face ID / Android fingerprint need the live HTTPS origin.
PAIDIA_WEBAUTHN_ORIGIN=http://127.0.0.1:5173
PAIDIA_WEBAUTHN_RP_ID=localhost
# PAIDIA_WEBAUTHN_ORIGIN=https://armonia-thassos.vercel.app
# PAIDIA_WEBAUTHN_RP_ID=armonia-thassos.vercel.app
PAIDIA_WEBAUTHN_RP_NAME=Armonia Thassos
PAIDIA_PASSKEY_STORE_PATH=.paidia-passkeys.json
# Optional one-time seed into DB (migrate script / first boot):
# PAIDIA_PASSKEYS_JSON=
# PAIDIA_OPS_JSON=
PAIDIA_ONBOARDING_STATE_PATH=.paidia-onboarding.json

# ── REQUIRED — Security ─
PAIDIA_TRUST_PROXY=false
PAIDIA_TRUSTED_PROXY_NETWORKS=
PAIDIA_TRUSTED_NETWORKS=
PAIDIA_LOGIN_MAX_ATTEMPTS=5
PAIDIA_LOGIN_WINDOW_SECONDS=600
PAIDIA_LOGIN_LOCK_SECONDS=900
PAIDIA_IP_MAX_FAILURES=20
PAIDIA_PROFILE_MAX_FAILURES=12
PAIDIA_SECURITY_ALERT_AFTER=3
PAIDIA_SECURITY_ALERT_COOLDOWN=3600
PAIDIA_SECURITY_ALERT_EMAIL=
PAIDIA_SECURITY_STATE_PATH=.paidia-security-state.json
PAIDIA_SECURITY_LOG_PATH=.paidia-security-events.jsonl

# ── REQUIRED — Email ─
# Local: SMTP (Gmail App Password) works well.
# Vercel: prefer Resend — outbound SMTP ports are often blocked.
# If both are set, local prefers SMTP and Vercel prefers Resend (with automatic fallback).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Resend — use a verified domain sender in production (not only @resend.dev).
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
RESEND_API_URL=https://api.resend.com/emails

# Public URL for PIN-reset links (must be the live site on Vercel).
# PAIDIA_PUBLIC_URL=https://armonia-thassos.vercel.app

# Admin broadcast limits (Team-Nachricht)
# PAIDIA_BROADCAST_COOLDOWN=45
# PAIDIA_BROADCAST_MAX=80

# Production WebAuthn (required for Face ID / Android biometrics on the live site):
# PAIDIA_WEBAUTHN_ORIGIN=https://armonia-thassos.vercel.app
# PAIDIA_WEBAUTHN_RP_ID=armonia-thassos.vercel.app

# ── OPTIONAL — Web Push (VAPID) ─
# When both keys are set, /api/health reports notifications.webPush=true and
# clients can PushManager.subscribe → POST /api/push/subscribe.
# Generate: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT=mailto:you@example.com
# (aliases: PAIDIA_VAPID_PUBLIC_KEY / PAIDIA_VAPID_PRIVATE_KEY)

# ── OPTIONAL — WhatsApp Cloud API ─
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_SEND_ENABLED=false
WHATSAPP_EVENT_TEMPLATE=paidia_event_notification
WHATSAPP_TEMPLATE_LANGUAGE=de
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_TEST_TEMPLATE=hello_world
WHATSAPP_TEST_LANGUAGE=en_US
WHATSAPP_RECIPIENTS_JSON={}

# ── OPTIONAL — Google Drive for Moments photos (offloads Vercel/DB) ─
# Create an OAuth client (Desktop) in Google Cloud, enable Drive API,
# share a Drive folder with the Google account you authorize, then run:
#   python3 scripts/google_drive_auth.py
# Paste the four values into Vercel env (and local .env).
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=
# GOOGLE_DRIVE_FOLDER_ID=
