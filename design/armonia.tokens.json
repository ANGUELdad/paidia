    "body": {
      "$value": {
        "fontFamily": "Outfit",
        "fontWeight": 400,
        "fontSize": "1rem",
        "lineHeight": "1.5",
        "letterSpacing": "0"
      }
    },
    "body-sm": {
      "$value": {
        "fontFamily": "Outfit",
        "fontWeight": 400,
        "fontSize": "0.9rem",
        "lineHeight": "1.45",
        "letterSpacing": "0"
      }
    },
    "label": {
      "$value": {
        "fontFamily": "Outfit",
        "fontWeight": 600,
        "fontSize": "0.85rem",
        "lineHeight": "1.3",
        "letterSpacing": "0"
      }
    },
    "caption": {
      "$value": {
        "fontFamily": "Outfit",
        "fontWeight": 600,
        "fontSize": "0.8125rem",
        "lineHeight": "1.35",
        "letterSpacing": "0"
      }
    },
    "eyebrow": {
      "$value": {
        "fontFamily": "Outfit",
        "fontWeight": 700,
        "fontSize": "0.6875rem",
        "lineHeight": "1.3",
        "letterSpacing": "0.14em"
      }
