{
  "name": "armonia-platform",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "cd apps/api && PYTHONPATH=. ../../.venv/bin/uvicorn armonia.main:app --reload --port 8000",
    "build:web": "npm run build -w apps/web",
    "db:generate": "npm run db:generate -w web",
    "db:push": "npm run db:push -w web",
    "test:api": "cd apps/api && PYTHONPATH=. ../../.venv/bin/python -m pytest -q",
    "migrate:ops": "python3 scripts/migrate_ops_to_prisma.py"
  }
}
